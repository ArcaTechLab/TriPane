{
  "name": "tripane",
  "version": "0.2.0",
  "private": true,
  "description": "A Polypane-style browser: one URL rendered side by side in Chromium, Firefox and WebKit via Playwright.",
  "type": "module",
  "scripts": {
    "start": "bun server/main.ts",
    "dev": "bun --watch server/main.ts --dev",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "postinstall": "playwright install chromium firefox webkit",
    "dist": "bun scripts/build-dist.ts",
    "compat": "bun scripts/gen-compat.ts",
    "icons": "bun scripts/gen-icons.ts"
  },
  "dependencies": {
    "lucide-preact": "^1.70.0",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.65.0",
    "pngjs": "^7.0.0",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@mdn/browser-compat-data": "^8.1.8",
    "@types/bun": "^1.4.4",
    "@types/pngjs": "^6.0.5",
    "bun-plugin-tailwind": "^0.1.2",
    "resedit": "^3.1.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "web-features": "^3.45.0"
  }
}
